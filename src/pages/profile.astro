---
import { getCollection, getEntries, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, topics } from '../site.config';
import { research } from '../lib/content';
import { photo } from '../lib/photos';

const profile = (await getEntry('profile', 'profile'))!.data;
const roles = await Promise.all(
  (await getCollection('experience'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (r) => ({ ...r, cases: await getEntries(r.data.caseStudies) })),
);
const credentials = (await getCollection('education')).sort(
  (a, b) =>
    Number(b.data.kind === 'degree') - Number(a.data.kind === 'degree') ||
    Number(b.data.status === 'in-progress') - Number(a.data.status === 'in-progress') ||
    b.data.year.localeCompare(a.data.year, undefined, { numeric: true }),
);
const pinned = (await research()).find((r) => r.data.pinned);
const portrait = photo(profile.portrait);
const photos = profile.photos.map((p) => ({ ...p, src: photo(p.image) }));
const statusLabel = { complete: '', 'in-progress': ' · in progress', coursework: ' · coursework' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    homeLocation: profile.based,
    knowsAbout: Object.values(topics).map((t) => t.name),
    sameAs: Object.values(site.links),
  },
};
const toc = [
  ['principles', 'What I believe'],
  ['work', 'What I work on'],
  ['experience', 'Experience'],
  ['skills', 'Skills'],
  ['education', 'Education'],
  ['recognition', 'Recognition'],
  ['community', 'Leadership'],
  ['next', "What's next"],
];
---

<Base title="Profile" description={`${site.name}: ${profile.subtitle}`} schema={schema}>
  <article class="sheet profile">
    <aside class="rail">
      {portrait ? (
        <img class="portrait" src={portrait} alt={site.name} width="144" height="180" />
      ) : (
        <div class="portrait photo-placeholder"><span>[Headshot]</span></div>
      )}
      <dl class="meta">
        <dt>Based in</dt><dd>{profile.based}</dd>
        <dt>{profile.focusLabel}</dt><dd>{profile.focus}</dd>
        {profile.hobby && <><dt>Hobby R&amp;D</dt><dd>{profile.hobby}</dd></>}
        {site.currently.studying && <><dt>Studying</dt><dd>{site.currently.studying}</dd></>}
        <dt>Contact</dt><dd><a href="/contact">Get in touch</a></dd>
      </dl>
      <nav class="toc" aria-label="On this page">
        <span class="label">On this page</span>
        <ul>
          {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </aside>

    <div class="main">
      <p class="eyebrow">Profile</p>
      <h1>{site.name}</h1>
      <p class="lede">{profile.subtitle}</p>

      {photos.length > 0 && (
        <>
          <h2 id="photos">Photos</h2>
          <div class="photos">
            {photos.map((p) => (
              <figure>
                {p.src ? <img src={p.src} alt={p.caption} loading="lazy" /> : <div class="photo-placeholder"><span>[Professional photo]</span></div>}
                <figcaption>{p.caption}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )}

      <h2 id="principles">What I believe</h2>
      <ol class="index">
        {profile.principles.map((p, i) => (
          <li><span class="meta">{String(i + 1).padStart(2, '0')}</span><div><span class="title">{p.title}</span><p>{p.text}</p></div></li>
        ))}
      </ol>

      <h2 id="work">What I work on</h2>
      {pinned && (
        <p>
          My primary research is <a href={`/research/${pinned.id}`}>{pinned.data.title}</a>. {pinned.data.summary}
        </p>
      )}
      <ul class="tags">
        {Object.entries(topics).map(([id, t]) => <li><a class="tag" href={`/topics/${id}`}>{t.name}</a></li>)}
      </ul>

      <div class="section-head"><h2 id="experience">Experience</h2><a href="/reference/experience">Full experience</a></div>
      <ol class="index">
        {roles.map((r) => (
          <li>
            <span class="meta">{r.data.start} –<br />{r.data.end}</span>
            <div>
              <span class="title">{r.data.role}</span><p>{r.data.organization}</p>
              {r.cases.length > 0 && (
                <p style="font-size:0.95rem"><span class="meta">Case studies</span>&nbsp; {r.cases.map((c, i) => <>{i > 0 && ' · '}<a href={`/lectures/${c.id}`}>{c.data.title}</a></>)}</p>
              )}
            </div>
          </li>
        ))}
      </ol>

      <h2 id="skills">Skills</h2>
      <ul class="index">
        {profile.skills.map((s) => (
          <li><span class="meta">{s.area}</span><span>{s.items.join(' · ')}</span></li>
        ))}
      </ul>

      <div class="section-head"><h2 id="education">Education &amp; credentials</h2><a href="/reference/education">Details</a></div>
      <ul class="index">
        {credentials.map((c) => (
          <li>
            <span class="meta">{c.data.year}{statusLabel[c.data.status]}</span>
            <div><span class="title">{c.data.title}</span><p>{c.data.issuer}</p></div>
          </li>
        ))}
      </ul>

      <h2 id="recognition">Recognition</h2>
      <ul class="index">
        {profile.recognition.map((r) => (
          <li><span class="meta">{r.year}</span><div><span class="title">{r.title}</span><p>{r.detail}</p></div></li>
        ))}
      </ul>

      <h2 id="community">Leadership &amp; community</h2>
      <ul class="index">
        {profile.community.map((c) => (
          <li><span class="meta">Role</span><div><span class="title">{c.title}</span><p>{c.detail}</p></div></li>
        ))}
      </ul>

      <h2 id="next">What's next</h2>
      <ol class="index">
        {profile.next.map((n, i) => <li><span class="meta">Step {i + 1}</span><span>{n}</span></li>)}
      </ol>

      <div class="panel" style="margin-top:3rem">
        <p style="margin:0">
          Working on similar questions, or want me to speak, teach or advise? <a href="/contact">Get in touch</a>.
        </p>
      </div>
    </div>
  </article>
</Base>
