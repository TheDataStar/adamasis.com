---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tags from '../components/Tags.astro';
import { blurb } from '../site.config';

const items = (await getCollection('library')).sort((a, b) => b.data.added.getTime() - a.data.added.getTime());
const shelves = [
  ['book', 'Books'],
  ['video', 'Streaming Content'],
  ['website', 'Websites'],
  ['tool', 'Tools'],
  ['course', 'Courses'],
  ['paper', 'Papers'],
] as const;
---

<Base title="Library" description="Books, streaming content, websites and tools I have used, recommend and reviewed.">
  <div class="wide">
    <p class="eyebrow">Library</p>
    <h1>Library <span class="muted" style="font-weight:400">(Resources &amp; Reviews)</span></h1>
    <p class="lede">{blurb('/library')}</p>
    <p class="meta">
      {shelves.filter(([f]) => items.some((i) => i.data.format === f)).map(([f, label], i) => (
        <>{i > 0 && ' · '}<a href={`#${f}`}>{label}</a></>
      ))}
    </p>

    {shelves.map(([format, label]) => {
      const shelf = items.filter((i) => i.data.format === format);
      return shelf.length > 0 && (
        <section id={format}>
          <div class="section-head"><h2>{label}</h2></div>
          <ul class="index">
            {shelf.map((i) => (
              <li class={i.data.cover ? 'with-cover' : undefined}>
                {i.data.cover ? <img class="cover" src={i.data.cover} alt="" loading="lazy" /> : <span class="meta">{i.data.year ?? ''}</span>}
                <div>
                  {i.data.cover && i.data.year && <span class="meta">{i.data.year}</span>}
                  {i.data.url ? <a class="title" href={i.data.url}>{i.data.title}</a> : <span class="title">{i.data.title}</span>}
                  <span class="muted"> · {i.data.creator}</span>
                  <p>{i.data.note}</p>
                  <div style="margin-top:0.5rem"><Tags topics={i.data.topics} tags={i.data.tags} /></div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
