---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import contact from '../data/contact.json';

// Copy is edited in the admin dashboard under Site → Contact page.
type Text = string | null | undefined;
const c = contact as {
  lede?: Text; intro?: Text; closing?: Text;
  reasons?: { title?: Text; text?: Text }[];
  cards?: { email?: Text; booking?: Text; linkedin?: Text; github?: Text };
};
const reasons = (c.reasons ?? []).filter((r) => r.title || r.text);
---

<Base title="Contact" description={`Get in touch with ${site.name} about AI and edge security, speaking, advising or mentoring.`}>
  <article class="sheet">
    <aside class="rail"><span class="meta">Contact</span></aside>
    <div class="main">
      <h1>Contact</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
      <div class="prose">
        {c.intro && <p>{c.intro}</p>}
        {reasons.length > 0 && (
          <ul>
            {reasons.map((r) => <li>{r.title && <strong>{r.title}</strong>}{r.title && r.text && ' '}{r.text}</li>)}
          </ul>
        )}
        {c.closing && <p>{c.closing}</p>}
      </div>
      <div class="cards contact-cards">
        {site.email && <a class="panel" href={`mailto:${site.email}`}><span class="meta">Email</span><h3>{site.email}</h3><p>{c.cards?.email}</p></a>}
        {site.phone && <a class="panel" href={`tel:${site.phone.replace(/[^0-9+]/g, '')}`}><span class="meta">Phone</span><h3>{site.phone}</h3><p>{site.phoneHours || 'Call or text.'}</p></a>}
        {site.bookingUrl && <a class="panel" href={site.bookingUrl}><span class="meta">Calendar</span><h3>Book a time</h3><p>{c.cards?.booking}</p></a>}
        {site.links.linkedin && <a class="panel" href={site.links.linkedin}><span class="meta">LinkedIn</span><h3>Connect</h3><p>{c.cards?.linkedin}</p></a>}
        {site.links.github && <a class="panel" href={site.links.github}><span class="meta">GitHub</span><h3>Source</h3><p>{c.cards?.github}</p></a>}
      </div>
    </div>
  </article>
</Base>
