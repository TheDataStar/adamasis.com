---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site, sections, hero } from '../site.config';
import { photo } from '../lib/photos';
import { lectures, journal, labs, research, papers, formatDate } from '../lib/content';

const [allLectures, allEntries, allLabs, allResearch, allPapers, library] = await Promise.all([
  lectures(), journal(), labs(), research(), papers(), getCollection('library'),
]);
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const pinned = allResearch.find((r) => r.data.pinned);

const details: Record<string, { count?: string; latest?: { title: string; href: string; date?: Date } }> = {
  '/lectures': {
    count: plural(allLectures.length, 'lecture'),
    latest: allLectures[0] && { title: allLectures[0].data.title, href: `/lectures/${allLectures[0].id}`, date: allLectures[0].data.published },
  },
  '/journal': {
    count: plural(allEntries.length, 'entry').replace('entrys', 'entries'),
    latest: allEntries[0] && { title: allEntries[0].data.title, href: `/journal/${allEntries[0].id}`, date: allEntries[0].data.date },
  },
  '/labs': { count: plural(allLabs.length, 'project'), latest: allLabs[0] && { title: allLabs[0].data.title, href: `/labs/${allLabs[0].id}` } },
  '/research': {
    count: `${plural(allResearch.length, 'topic')}${allPapers.length ? ` · ${plural(allPapers.length, 'paper')}` : ''}`,
    latest: pinned && { title: pinned.data.title, href: `/research/${pinned.id}` },
  },
  '/library': { count: plural(library.length, 'item') },
};
const portrait = photo((await getEntry('profile', 'profile'))?.data.portrait);
const headline = site.headline.split('\n').join(' ');
const current = [
  ['Studying', site.currently.studying],
  ['Reading', site.currently.reading],
  ['Building', site.currently.building],
].filter(([, value]) => value);
---

<Base>
  <div class="home">
  <section class="hero wide with-portrait">
    <div>
      <h1 class="typewriter" aria-label={headline}>
        <span class="tw-ghost">
          <span class="tw-line tw-line-0">{hero.lead} <span class="ed-struck">{hero.struck}</span> <span class="ed-word">{hero.word}</span> {hero.rest}</span>
          <span class="tw-line tw-line-1">{hero.tagline}</span>
        </span>
        <span class="tw-out" aria-hidden="true" data-hero={JSON.stringify(hero)}>
          <span class="tw-line tw-line-0"><span class="tw-a"></span><span class="ed-struck"><span class="tw-b"></span></span><span class="ed-word tw-c"></span><span class="tw-d"></span></span>
          <span class="tw-line tw-line-1"></span>
        </span>
      </h1>
      {site.thesis && <p class="thesis">{site.thesis}</p>}
    </div>
    {portrait ? (
      <img class="hero-portrait" src={portrait} alt={site.name} width="220" height="275" />
    ) : (
      <div class="hero-portrait photo-placeholder"><span>[Professional headshot]</span></div>
    )}
  </section>

  {current.length > 0 && (
    <section class="wide" style="margin:2rem 0">
      <div class="cards">
        {current.map(([label, value]) => <div class="panel"><span class="label meta">{label}</span><p>{value}</p></div>)}
      </div>
    </section>
  )}

  <section class="wide">
    <div class="guide">
      {sections.filter((s) => s.href !== '/contact').map((s) => {
        const d = details[s.href];
        return (
          <a class="panel guide-card" href={s.href}>
            <h3>{s.name}{s.note && <span class="note"> ({s.note})</span>}</h3>
            <p class="blurb">{s.blurb}</p>
            {d && (
              <p class="meta guide-foot">
                {d.count}
                {d.latest && <><br />Latest: <span class="latest">{d.latest.title}</span>{d.latest.date && ` · ${formatDate(d.latest.date, 'short')}`}</>}
              </p>
            )}
          </a>
        );
      })}
    </div>
  </section>

  {site.upcoming.length > 0 && (
    <section class="wide">
      <div class="section-head"><h2>Upcoming</h2></div>
      <ul class="index">
        {site.upcoming.map((u) => (
          <li><span class="meta">{u.date}</span>{u.url ? <a href={u.url}>{u.title}</a> : <span>{u.title}</span>}</li>
        ))}
      </ul>
    </section>
  )}
  </div>
</Base>

<script>
  const h = document.querySelector<HTMLElement>('.typewriter');
  const out = h?.querySelector<HTMLElement>('.tw-out');
  if (h && out && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const { lead, struck, word, rest, tagline } = JSON.parse(out.dataset.hero ?? '{}') as Record<string, string>;
    const el = {
      a: out.querySelector<HTMLElement>('.tw-a')!,
      b: out.querySelector<HTMLElement>('.tw-b')!,
      c: out.querySelector<HTMLElement>('.tw-c')!,
      d: out.querySelector<HTMLElement>('.tw-d')!,
    };
    out.querySelector<HTMLElement>('.tw-line-1')!.textContent = tagline;
    const caret = document.createElement('span');
    caret.className = 'tw-caret';
    const pace = 0.9;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms * pace));
    const keystroke = () => 70 + Math.random() * 70;

    const type = async (target: HTMLElement, text: string, speed = keystroke) => {
      target.after(caret);
      for (const ch of text) {
        target.textContent += ch;
        await sleep(ch === ' ' ? 130 : speed());
      }
    };

    const run = async () => {
      h.classList.add('tw-run');
      await sleep(600);
      await type(el.a, `${lead} `);
      await type(el.b, struck);
      await type(el.d, ` ${rest}`);
      await sleep(1100);
      // The edit: strike the old verb, then write the new one beside it.
      el.b.parentElement!.after(caret);
      await sleep(500);
      h.classList.add('ed-strike-on');
      await sleep(650);
      await type(el.c, ` ${word}`, () => 95 + Math.random() * 60);
      el.d.after(caret);
      h.classList.add('tw-done');
      setTimeout(() => caret.remove(), 3100);
    };
    run();
  }
</script>
