---
import Base from '../../layouts/Base.astro';
import { lectures, formatDate, formatLabel } from '../../lib/content';

const all = await lectures();
---

<Base title="Lectures" description="Professional essays, articles, white papers and case studies on AI, robotics and edge computing.">
  <div class="wide">
    <p class="eyebrow">Lectures</p>
    <h1>Lectures</h1>
    <p class="lede">
      Professional essays, articles and white papers. <strong>For the Board Room</strong> pieces explain technology for
      decision-makers, <strong>In the Classroom</strong> pieces are written for students and new technologists,
      <strong>Teardowns</strong> take a product or claim apart, and <strong>Case Studies</strong> document work from my career.
    </p>
    {all.length === 0 ? <p class="muted">The first lecture is in progress.</p> : (
      <ul class="index">
        {all.map((l) => (
          <li>
            <span class="meta">{formatLabel[l.data.format]}<br />{formatDate(l.data.published, 'short')}</span>
            <div><a class="title" href={`/lectures/${l.id}`}>{l.data.title}</a><p>{l.data.summary}</p></div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
