---
import Base from '../../layouts/Base.astro';
import { labs } from '../../lib/content';
import { blurb } from '../../site.config';

const all = await labs();
---

<Base title="Labs" description="Personal projects in AI, robotics and edge computing, with their research and development artifacts.">
  <div class="wide">
    <p class="eyebrow">Labs</p>
    <h1>Labs</h1>
    <p class="lede">{blurb('/labs')}</p>
    <p class="muted">Case studies from my career live in <a href="/lectures">Lectures</a>.</p>
    <div class="cards" style="margin-top:2rem">
      {all.map((lab) => (
        <a class="panel" href={`/labs/${lab.id}`}>
          <span class="meta"><span class={`status ${lab.data.status}`}>{lab.data.status}</span> · {lab.data.period}</span>
          <h3>{lab.data.title}</h3>
          <p>{lab.data.summary}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
