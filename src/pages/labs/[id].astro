---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import Backlinks from '../../components/Backlinks.astro';
import Supports from '../../components/Supports.astro';
import { site } from '../../site.config';
import { labs, formatDate } from '../../lib/content';
import { repoActivity } from '../../lib/github';

export async function getStaticPaths() {
  return (await labs()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const activity = d.repo ? await repoActivity(d.repo) : null;
const schema = {
  '@context': 'https://schema.org',
  '@type': d.repo ? 'SoftwareSourceCode' : 'CreativeWork',
  name: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: site.name, url: site.url },
  ...(d.repo && { codeRepository: d.repo }),
};
---

<Base title={d.title} description={d.summary} image={`/og/labs/${entry.id}.png`} schema={schema}>
  <article class="sheet">
    <aside class="rail">
      <dl class="meta">
        <dt>{d.kind === 'project' ? 'Project' : 'Case study'}</dt><dd><span class={`status ${d.status}`}>{d.status}</span></dd>
        <dt>Role</dt><dd>{d.role}</dd>
        <dt>Period</dt><dd>{d.period}</dd>
        {d.repo && <><dt>Source</dt><dd><a href={d.repo}>Repository</a></dd></>}
        {activity?.pushed && <><dt>Last commit</dt><dd>{formatDate(activity.pushed, 'short')}</dd></>}
        {d.url && <><dt>Live</dt><dd><a href={d.url}>Visit</a></dd></>}
        <Supports refs={d.research} />
      </dl>
    </aside>
    <div class="main">
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.stack.length > 0 && <p class="meta">Built with: {d.stack.join(' · ')}</p>}
      <div class="prose"><Content /></div>
      <div class="after">
        <Tags topics={d.topics} tags={d.tags} />
        <div style="height:1.5rem"></div>
        <Backlinks entry={entry} />
      </div>
    </div>
  </article>
</Base>
