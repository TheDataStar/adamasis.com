---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import Backlinks from '../../components/Backlinks.astro';
import Supports from '../../components/Supports.astro';
import { site } from '../../site.config';
import { labs, formatDate } from '../../lib/content';
import { repoActivity } from '../../lib/github';

export async function getStaticPaths() {
  return (await labs()).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const artifacts = d.artifacts
  .map((a) => ({
    ...a,
    href: a.file || a.url,
    // Uploaded files are stored as file.<ext>; download them under the artifact's label instead.
    download: a.file ? `${a.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}${a.file.match(/\.[a-z0-9]+$/i)?.[0] ?? ''}` : undefined,
  }))
  .filter((a) => a.href);
const activity = d.repo ? await repoActivity(d.repo) : null;
const schema = {
  '@context': 'https://schema.org',
  '@type': d.repo ? 'SoftwareSourceCode' : 'CreativeWork',
  name: d.title,
  description: d.summary,
  author: { '@type': 'Person', name: site.name, url: site.url },
  ...(d.repo && { codeRepository: d.repo }),
};
---

<Base title={d.title} description={d.summary} image={`/og/labs/${entry.id}.png`} schema={schema}>
  <article class="sheet">
    <aside class="rail">
      <dl class="meta">
        <dt>Project</dt><dd><span class={`status ${d.status}`}>{d.status}</span></dd>
        <dt>Role</dt><dd>{d.role}</dd>
        <dt>Period</dt><dd>{d.period}</dd>
        {d.repo && <><dt>Source</dt><dd><a href={d.repo}>Repository</a></dd></>}
        {activity?.pushed && <><dt>Last commit</dt><dd>{formatDate(activity.pushed, 'short')}</dd></>}
        {d.url && <><dt>Live</dt><dd><a href={d.url}>Visit</a></dd></>}
        <Supports refs={d.research} />
      </dl>
    </aside>
    <div class="main">
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.stack.length > 0 && <p class="meta">Built with: {d.stack.join(' · ')}</p>}
      <div class="prose"><Content /></div>
      {artifacts.length > 0 && (
        <section class="artifacts" aria-labelledby="artifacts-title">
          <div class="section-head"><h2 id="artifacts-title">Artifacts</h2></div>
          <ul class="index">
            {artifacts.map((a) => (
              <li>
                <span class="meta">{a.kind || (a.file ? 'Download' : 'Link')}</span>
                <a class="title" href={a.href} {...(a.download ? { download: a.download } : { rel: 'noopener' })}>{a.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="after">
        <Tags topics={d.topics} tags={d.tags} />
        <div style="height:1.5rem"></div>
        <Backlinks entry={entry} />
      </div>
    </div>
  </article>
</Base>
