---
import Base from '../../layouts/Base.astro';
import { journal, formatDate } from '../../lib/content';

const all = await journal();
---

<Base title="Journal" description="Opinion pieces, briefs and general thoughts on the changing world of technology.">
  <div class="wide">
    <p class="eyebrow">Journal</p>
    <h1>Journal</h1>
    <p class="lede">
      Opinion pieces, briefs and general thoughts, organized by date and tag. Each entry is marked by how settled
      the thinking is: <span class="status meta hypothesis">hypothesis</span>, <span class="status meta testing">testing</span> or
      <span class="status meta confirmed">confirmed</span>.
    </p>
    {all.length === 0 ? <p class="muted">Entry 001 is coming soon.</p> : (
      <ul class="index">
        {all.map((e) => (
          <li>
            <span class="meta">Entry {e.number}<br />{formatDate(e.data.date, 'short')}</span>
            <div>
              <a class="title" href={`/journal/${e.id}`}>{e.data.title}</a>
              <p><span class={`status meta ${e.data.status}`}>{e.data.status}</span> · {e.data.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
