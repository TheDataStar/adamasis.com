---
import '../styles/global.css';
import { site, sections } from '../site.config';
import Social from '../components/Social.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description = site.description, image, type = 'website', schema, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Notebook`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? '/og/default.png', Astro.site).href;
const path = Astro.url.pathname;

const nav = sections.map((s) => [s.name, s.href]);
const current = (href: string) => path.startsWith(href);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  sameAs: Object.values(site.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f7f4ec" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: everything`} href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Lectures`} href="/lectures/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Journal`} href="/journal/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(schema ?? person)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="frame">
      <header class="site">
        <a class="name" href="/" aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>
        <div class="header-right" id="site-menu">
          <nav class="site" aria-label="Main">
            <ul>
              {nav.map(([label, href]) => (
                <li><a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a></li>
              ))}
            </ul>
          </nav>
          <Social />
        </div>
        <div class="header-tools">
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch to night mode" title="Night mode">
            <svg class="i-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" /></svg>
            <svg class="i-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" /><path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" /></svg>
          </button>
          <button class="menu-btn" type="button" id="menu-toggle" aria-expanded="false" aria-controls="site-menu">Menu</button>
        </div>
      </header>

      <main id="content">
        <slot />
      </main>

      <footer class="site">
        <div>
          <strong>{site.name}</strong>
          <p class="muted" style="margin:0.5rem 0 0">{site.thesis || site.description}</p>
        </div>
        <div>
          <span class="label">Reference</span>
          <ul>
            <li><a href="/profile">Profile</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/reference/experience">Experience</a></li>
            <li><a href="/reference/education">Education &amp; Credentials</a></li>
            <li><a href="/reference/colophon">Colophon</a></li>
          </ul>
        </div>
        <div>
          <span class="label">Follow</span>
          <div style="margin-top:0.6rem"><Social size={20} /></div>
          <ul>
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </div>
        <div class="meta">
          © {new Date().getFullYear()} {site.name}<br />
          Rev. {new Date().toISOString().slice(0, 10)}
        </div>
      </footer>
    </div>
    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const label = () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'Paper mode' : 'Night mode';
        toggle.title = next;
        toggle.setAttribute('aria-label', `Switch to ${next.toLowerCase()}`);
      };
      label();
      toggle.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        if (dark) document.documentElement.dataset.theme = 'dark';
        else delete document.documentElement.dataset.theme;
        try { localStorage.setItem('theme', dark ? 'dark' : 'paper'); } catch {}
        label();
      });
      const menu = document.getElementById('menu-toggle');
      const setMenu = (open) => {
        menu.setAttribute('aria-expanded', String(open));
        menu.textContent = open ? 'Close' : 'Menu';
        document.documentElement.classList.toggle('menu-open', open);
      };
      menu.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.getAttribute('aria-expanded') === 'true') { setMenu(false); menu.focus(); }
      });
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const lang = pre.dataset.language;
        const bar = document.createElement('div');
        bar.className = 'code-bar';
        bar.innerHTML = `<span>${lang && lang !== 'plaintext' ? lang : 'code'}</span><button type="button">Copy</button>`;
        bar.querySelector('button').addEventListener('click', async (e) => {
          await navigator.clipboard.writeText(pre.innerText);
          e.target.textContent = 'Copied';
          setTimeout(() => (e.target.textContent = 'Copy'), 1500);
        });
        pre.before(bar);
      });
      if ('serviceWorker' in navigator && !['localhost', '127.0.0.1'].includes(location.hostname)) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>
